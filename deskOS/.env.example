PORT=3000

# S3-compatible storage (works with local MinIO, AWS S3, or Cloudflare R2 -
# only S3_ENDPOINT needs to change between them).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=deskos-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/deskos-media
S3_REGION=us-east-1

# Set to "true" to make scripts/create-bucket.js enable public read on
# the products/ prefix.
STORAGE_PUBLIC=true
